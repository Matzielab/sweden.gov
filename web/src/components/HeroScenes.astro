---
/**
 * The hero's picture carousel: four flat Swedish scenes, each paired with an
 * example question. Clicking a scene asks its question — the carousel is the
 * suggestion list (app.ts binds [data-suggestion]).
 */

export const scenes = [
  { id: "stuga", question: "Hur fungerar ROT-avdraget?" },
  { id: "park", question: "Hur mycket får jag i föräldrapenning?" },
  { id: "fjall", question: "Hur byter jag ett utländskt körkort till ett svenskt?" },
  { id: "skargard", question: "Hur ansöker jag om pass?" },
]

// Deterministic "random", so the forest looks the same on every build
const rand = (i: number) => {
  const v = Math.sin(i * 127.1 + 311.7) * 43758.5453
  return v - Math.floor(v)
}

/** A three-tier spruce as one path. */
const spruce = (x: number, base: number, h: number) => {
  const w = h * 0.46
  const tier = (top: number, bottom: number, width: number) =>
    `M${x.toFixed(1)} ${top.toFixed(1)}L${(x + width / 2).toFixed(1)} ${bottom.toFixed(1)}L${(x - width / 2).toFixed(1)} ${bottom.toFixed(1)}Z`
  return (
    tier(base - h, base - h * 0.45, w * 0.6) +
    tier(base - h * 0.72, base - h * 0.2, w * 0.8) +
    tier(base - h * 0.46, base, w)
  )
}

const forest = (from: number, to: number, base: number, min: number, max: number, seed: number) => {
  const trees: string[] = []
  for (let x = from, i = 0; x < to; x += 11 + rand(seed + i) * 7, i++) {
    trees.push(spruce(x, base + rand(seed + i + 99) * 4, min + rand(seed + i + 50) * (max - min)))
  }
  return trees.join("")
}

// Scene 1: the ladder against the cottage wall
const ladder = Array.from({ length: 6 }, (_, i) => {
  const t = (i + 0.6) / 6.4
  const lerp = (a: number, b: number) => (a + (b - a) * t).toFixed(1)
  return `M${lerp(350, 373)} ${lerp(294, 228)}L${lerp(364, 387)} ${lerp(294, 228)}`
}).join("")

const flowers = Array.from({ length: 22 }, (_, i) => ({
  x: 300 + rand(i + 7) * 300,
  y: 305 + rand(i + 31) * 70,
  c: i % 3 === 0 ? "#fff" : "#fecb00",
}))

// Scene 2: a row of Stockholm-ish facades
const facadeColors = ["#e2b04f", "#cf7a52", "#efd9a0", "#b7c7a1", "#d99a8c", "#e8c77d", "#c86f4d", "#d8cfb8"]
const buildings = (() => {
  const widths = [70, 58, 82, 54, 76, 64, 88, 62, 70]
  const heights = [112, 134, 96, 146, 106, 128, 100, 122, 110]
  let x = -12
  return widths.map((w, i) => {
    const h = heights[i]
    const b = { x, y: 252 - h, w, h, color: facadeColors[i % facadeColors.length], windows: [] as { x: number; y: number }[] }
    const cols = Math.floor((w - 14) / 15)
    const rows = Math.floor((h - 26) / 22)
    const offset = (w - cols * 15) / 2 + 3
    for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) b.windows.push({ x: x + offset + c * 15, y: b.y + 16 + r * 22 })
    x += w
    return b
  })
})()

// Scene 3: the road's centre dashes, growing toward the viewer
const dashes = Array.from({ length: 7 }, (_, i) => {
  const t0 = Math.pow(i / 7, 1.7)
  const t1 = Math.pow((i + 0.5) / 7, 1.7)
  const y = (t: number) => 252 + t * 128
  return { y1: y(t0), y2: y(t1), w: 1.5 + t0 * 5 }
})
---

