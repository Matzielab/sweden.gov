# Anything other than "production" counts as dev, which enables the /doc and
# /reference API docs.
ENVIRONMENT=development

# Optional: port to bind. Defaults to 3000.
# PORT=3000

# Where the website runs — the CORS origin. Comma-separate several.
# Defaults to the Astro dev server.
FRONTEND_URL=http://localhost:4321

# --- AI provider -------------------------------------------------------------
# Any OpenAI-compatible chat completions API. The model MUST support tool
# (function) calling. Examples:
#   OpenAI       OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1         OPENAI_COMPATIBLE_MODEL=gpt-4.1-mini
#   Berget (SE)  OPENAI_COMPATIBLE_BASE_URL=https://api.berget.ai/v1          OPENAI_COMPATIBLE_MODEL=<model id>
#   Mistral (EU) OPENAI_COMPATIBLE_BASE_URL=https://api.mistral.ai/v1         OPENAI_COMPATIBLE_MODEL=mistral-medium-latest
#   OpenRouter   OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1      OPENAI_COMPATIBLE_MODEL=<vendor/model>
#   Ollama       OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1         OPENAI_COMPATIBLE_MODEL=qwen3:14b
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=sk-your-key-here
OPENAI_COMPATIBLE_MODEL=gpt-4.1-mini

# Optional: sampling temperature (unset = provider default)
# OPENAI_COMPATIBLE_TEMPERATURE=0.2

# Optional: max search/read round trips per question. Defaults to 8.
# AGENT_MAX_STEPS=8

# --- Search ------------------------------------------------------------------
# Search is a fallback chain: every search tries the configured providers in
# order and the first one that answers wins. A provider that gets blocked or
# rate-limited is skipped for SEARCH_COOLDOWN_SECONDS (a timeout: 30s).
# Unconfigured providers are skipped; DuckDuckGo (keyless scraping, blocks
# busy servers) needs no config and is the last resort.
# SEARCH_PROVIDERS=searxng,brave,duckduckgo
# SEARCH_COOLDOWN_SECONDS=300
#
# SearXNG — your own instance (free, self-hosted). Enable the JSON format in
# its settings.yml:  search: { formats: [html, json] }
# SEARXNG_URL=http://localhost:8080
#    Optional: sent as "Authorization: Bearer <key>" for an instance behind
#    an auth proxy.
# SEARXNG_BEARER_KEY=
#    Optional: which engines to ask per search. Unset = the instance's enabled
#    defaults. Engines disabled in settings.yml can still be named here. These
#    returned good Swedish government results in testing (Sept 2026):
# SEARXNG_ENGINES=yahoo,resulthunter,zapmeta,google
#
# Brave Search API — https://api-dashboard.search.brave.com
# BRAVE_SEARCH_API_KEY=
#    The free plan allows 1 request/second; searches are spaced this far apart.
# BRAVE_MIN_INTERVAL_MS=1100

# --- Abuse protection --------------------------------------------------------
# Questions per IP per window. 0 disables the limit.
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MINUTES=10
# Where the real client IP comes from. Behind a reverse proxy every request
# comes from the proxy, so leaving this off makes all visitors share ONE
# rate limit. But only enable it when a proxy you control sets the headers,
# or clients could spoof their IP to dodge the limit.
#   true       → X-Real-IP / X-Forwarded-For (Traefik, Caddy, nginx…)
#   cloudflare → CF-Connecting-IP (only when Cloudflare is in front)
# TRUST_PROXY=false
